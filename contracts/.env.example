# EVM chain the Hardhat scripts talk to.
#   - Local dev (anvil): http://127.0.0.1:8545  (default; chainId 31337)
#   - Monad testnet:     https://testnet-rpc.monad.xyz
#   - Sepolia:           https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
RPC_URL=http://127.0.0.1:8545

# Chain id matching the RPC above (31337 for anvil, 11155111 for Sepolia).
CHAIN_ID=31337

# Private key of the deployer account (hex, with or without 0x).
# On local anvil, the well-known account #0 (0xac09...ff80) is used when unset.
PRIVATE_KEY=

# Optional: Etherscan API key for `npx hardhat verify`.
ETHERSCAN_API_KEY=