# Solana anchor program — required when building/deploying the Rust program
#   localnet: http://127.0.0.1:8899   devnet: https://api.devnet.solana.com
SOLANA_RPC_URL=http://127.0.0.1:8899

# Base58 private key of a funded wallet (clients, migration). 
SOLANA_PRIVATE_KEY=

# Path to the anchor provider wallet json (default: wallet.json)
ANCHOR_WALLET=wallet.json