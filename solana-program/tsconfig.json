{
  "compilerOptions": {
    "types": ["mocha", "node"],
    "type": "module",
    "module": "commonjs",
    "resolveJsonModule": true,
    "target": "ES2020",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["./app/**/*.ts", "./tests/**/*.ts", "./migrations/**/*.ts"]
}